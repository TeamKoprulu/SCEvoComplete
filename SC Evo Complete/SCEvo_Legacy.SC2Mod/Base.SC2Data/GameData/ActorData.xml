    <CActorEventMacro id="SCBW_ZergSmallBurrowEffects">
        <On Terms="AbilMorph.*.Finish; AbilKey BurrowDown; HasAllianceTypeWith Enemy" Send="SetOpacity 0.000000 0.250000 BurrowOpacity"/>
        <On Terms="AbilMorph.*.Start; AbilKey BurrowUp; HasAllianceTypeWith Enemy" Send="ClearOpacity 0.000000 BurrowOpacity"/>
        <On Terms="UnitDetectedByViewer.*.On; HasAllianceTypeWith Enemy; ValidateUnit IsBuried" Send="SetOpacity 0.000000 0.000000 BurrowOpacity"/>
        <On Terms="UnitDetectedByViewer.*.Off; HasAllianceTypeWith Enemy; ValidateUnit IsBuried" Send="ClearOpacity 0.000000 BurrowOpacity"/>
        <On Terms="UnitPlayerChange; !HasAllianceTypeWith Enemy" Send="ClearOpacity 0.000000 BurrowOpacity"/>
    </CActorEventMacro>
